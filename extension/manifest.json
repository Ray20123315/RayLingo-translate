{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "description": "__MSG_extDescription__",
  "version": "0.4.8",
  "default_locale": "zh_TW",
  "permissions": [
    "storage",
    "contextMenus",
    "clipboardRead",
    "clipboardWrite",
    "offscreen",
    "tts"
  ],
  "host_permissions": [
    "https://translate.googleapis.com/*",
    "https://piper.ttstool.com/*",
    "https://raw.githubusercontent.com/*"
  ],
  "action": {
    "default_title": "__MSG_extName__",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "platform-compat.js",
        "integrity-client.js",
        "language-registry.js",
        "ui-i18n.js",
        "translator-engine.js",
        "tts-registry.js",
        "selection-appearance.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "exclude_matches": [
        "https://piper.ttstool.com/*"
      ]
    },
    {
      "matches": [
        "https://piper.ttstool.com/*"
      ],
      "js": [
        "platform-compat.js",
        "piper-autoinstall.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; frame-src https://piper.ttstool.com"
  }
}
